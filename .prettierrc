{
  "semi": false,
  "singleQuote": true,
  "printWidth": 80,
  "proseWrap": "always",
  "trailingComma": "all",
  "tabWidth": 2,
  "useTabs": false,
  "plugins": [
    "prettier-plugin-astro",
    "prettier-plugin-tailwindcss",
    "prettier-plugin-astro-organize-imports"
  ],
  "overrides": [
    {
      "files": "*.astro",
      "options": {
        "parser": "astro"
      }
    },
    {
      "files": "*.mdx",
      "options": {
        "parser": "mdx"
      }
    }
  ]
}
